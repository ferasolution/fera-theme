          "widgetType": "accordion",
          "settings": {
            "tabs": [
              {
                "_id": "p000101",
                "tab_title": "How long will the project take?",
                "tab_content": "<p>The timeline depends on the requirements, integrations and review stages. We discuss milestones in your proposal rather than promise a fixed delivery date before discovery.</p>"
              },
              {
                "_id": "p000102",
                "tab_title": "Can you improve an existing website?",
                "tab_content": "<p>Yes. Tell us what is working, what needs to change and which platform you use. We will review the existing site before recommending the scope.</p>"
              },
              {
                "_id": "p000103",
                "tab_title": "How are revisions and support handled?",
                "tab_content": "<p>Revision stages, communication and any ongoing support are agreed in the project scope. Ask us to include the support you need in your proposal.</p>"
              },
              {
                "_id": "p000104",
                "tab_title": "Are these demos client projects?",
                "tab_content": "<p>No. The demonstrations use synthetic data and illustrative brands. They show interface concepts and interactive workflows; they are not testimonials or deployed client products.</p>"
              }
            ],
            "active_item": 0,
            "_css_classes": "studio-faq"
